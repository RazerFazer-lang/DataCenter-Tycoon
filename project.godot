; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="DataCenter Tycoon Co-op"
config/description="3D First-Person Co-op DataCenter Simulator in Godot 4"
config/version="3.6.2"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.0431373, 0.0509804, 0.0627451, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/branding/boot_splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/stretch_mode=1
config/icon="res://assets/branding/app_icon.png"
config/windows_native_icon="res://assets/branding/app_icon.ico"

[autoload]

SettingsManager="*res://scripts/autoload/settings_manager.gd"
SecurityGuard="*res://scripts/autoload/security_guard.gd"
MatLib="*res://scripts/autoload/material_library.gd"
ModelLoader="*res://scripts/autoload/model_loader.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
SfxManager="*res://scripts/autoload/sfx_manager.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"
SessionKeeper="*res://scripts/autoload/session_keeper.gd"
Achievements="*res://scripts/autoload/achievement_manager.gd"
Operations="*res://scripts/autoload/operations_manager.gd"
Staff="*res://scripts/autoload/staff_manager.gd"
Cyber="*res://scripts/autoload/cyber_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"
FinanceManager="*res://scripts/autoload/finance_manager.gd"
MarketManager="*res://scripts/autoload/market_manager.gd"
MailManager="*res://scripts/autoload/mail_manager.gd"
TechnicianManager="*res://scripts/autoload/technician_manager.gd"
DecorManager="*res://scripts/autoload/decor_manager.gd"
OutdoorManager="*res://scripts/autoload/outdoor_manager.gd"
AdminManager="*res://scripts/autoload/admin_manager.gd"
PcScreenState="*res://scripts/autoload/pc_screen_state.gd"
PerfOverlay="*res://scripts/ui/perf_overlay.gd"
StatsHistory="*res://scripts/autoload/stats_history.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[internationalization]

locale/translations=PackedStringArray("res://translations/strings.en.translation")
locale/fallback="de"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
occlusion_culling/use_occlusion_culling=true
reflections/reflection_atlas/reflection_count=8
