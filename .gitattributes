*.blend1 binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg -diff
*.ico binary
*.ogg binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.ttf binary
*.otf binary
*.bin binary
*.res binary
*.scn binary
*.translation binary
*.pck binary
*.exe binary
*.dll binary
*.zip binary
