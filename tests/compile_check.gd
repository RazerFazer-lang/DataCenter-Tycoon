func _initialize() -> void:
	await process_frame
	var failed := 0
	for path in SCRIPTS:
		var s := load(path) as GDScript
		if s == null or not s.can_instantiate():
			print("FEHLER  ", path)
			failed += 1
		else:
			print("OK      ", path)
	print("Ergebnis: %d Fehler" % failed)
	quit(1 if failed > 0 else 0)