<Window x:Class="DataCenterLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataCenter Tycoon Launcher"
        Width="1200" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentRed}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#E00E141F"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22,18"/>
        </Style>

        <Style x:Key="PageCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="#F00C111A"/>
            <Setter Property="Padding" Value="30,24"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="14" Background="{StaticResource BgDeep}" BorderBrush="#263B54" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="0" Opacity="0.72"/>
        </Border.Effect>

        <Grid>
            <!-- Spielbild als Hintergrund -->
            <Border CornerRadius="13">
                <Border.Background>
                    <ImageBrush ImageSource="/Assets/loading_bg.png" Stretch="UniformToFill" AlignmentY="Center"/>
                </Border.Background>
            </Border>
            <Border CornerRadius="13">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E6070B12" Offset="0"/>
                        <GradientStop Color="#40070B12" Offset="0.30"/>
                        <GradientStop Color="#99070B12" Offset="0.70"/>
                        <GradientStop Color="#F5070B12" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="13">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#B3070B12" Offset="0"/>
                        <GradientStop Color="#00070B12" Offset="0.55"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITELLEISTE MIT TABS -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#24E082" Offset="0"/>
                                    <GradientStop Color="#1EC5E8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="DC" Foreground="#07121A" FontWeight="Black" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DATACENTER" Foreground="{StaticResource TextMain}" FontWeight="Black" FontSize="14"/>
                            <TextBlock Text="TYCOON" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="10.5" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
                        <Button x:Name="NavPlayBtn" Style="{StaticResource TabButton}" Content="Spielen" Click="NavPlayBtn_Click"/>
                        <Button x:Name="NavNotesBtn" Style="{StaticResource TabButton}" Content="Patchnotes" Click="NavNotesBtn_Click"/>
                        <Button x:Name="NavUpdatesBtn" Style="{StaticResource TabButton}" Content="Updates" Click="NavUpdatesBtn_Click"/>
                        <Button x:Name="NavDevBtn" Style="{StaticResource TabButton}" Content="Entwickler" Click="NavDevBtn_Click"/>
                        <Button x:Name="NavSettingsBtn" Style="{StaticResource TabButton}" Content="Einstellungen" Click="NavSettingsBtn_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TopBarHint" Grid.Column="2" Text="" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                               VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="240" TextTrimming="CharacterEllipsis"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Style="{StaticResource WindowButton}" Content="—" ToolTip="Minimieren" Click="MinimizeBtn_Click"/>
                        <Button Style="{StaticResource CloseWindowButton}" Content="✕" ToolTip="Schließen" Margin="4,0,0,0" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>

                <!-- SEITEN -->
                <Grid Grid.Row="1">

                    <!-- SPIELEN -->
                    <Grid x:Name="PagePlay" Margin="44,6,32,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="370"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,36,6">
                            <Border x:Name="HeroStateBorder" HorizontalAlignment="Left" CornerRadius="6" Padding="10,4" Margin="0,0,0,14"
                                    Background="#3324D87A" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1">
                                <TextBlock x:Name="HeroStateBadge" Text="BEREIT" Foreground="{StaticResource AccentGreen}" FontSize="11.5" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="DATACENTER" Foreground="{StaticResource TextMain}" FontSize="56" FontWeight="Black"/>
                            <TextBlock Text="TYCOON" Foreground="{StaticResource AccentCyan}" FontSize="56" FontWeight="Black" Margin="0,-16,0,10"/>
                            <TextBlock Text="Baue dein eigenes Rechenzentrum, allein oder im Co-op mit Freunden."
                                       Foreground="#C4D6E8" FontSize="15" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left" Margin="0,0,0,18"/>
                            <WrapPanel>
                                <Button x:Name="HeroCheckUpdatesBtn" Style="{StaticResource SecondaryButton}" Content="⟳ Nach Updates suchen" Margin="0,0,10,0" Click="CheckUpdateBtn_Click"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="📁 Spielstände" Click="OpenSavesBtn_Click"/>
                            </WrapPanel>
                        </StackPanel>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" VerticalAlignment="Bottom">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="SPIELSITZUNG" Foreground="{StaticResource AccentCyan}" FontSize="12" FontWeight="Bold" Margin="0,0,0,14"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Spielername"/>
                                    <TextBox x:Name="PlayerNameBox" MaxLength="24" Margin="0,0,0,12"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Grafikqualität"/>
                                    <ComboBox x:Name="QualityCombo" Margin="0,0,0,12">
                                        <ComboBoxItem Content="Niedrig"/>
                                        <ComboBoxItem Content="Mittel"/>
                                        <ComboBoxItem Content="Hoch"/>
                                        <ComboBoxItem Content="Ultra"/>
                                    </ComboBox>

                                    <TextBlock x:Name="HomeRepoHint" Text="" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>

                    <!-- PATCHNOTES -->
                    <Grid x:Name="PageNotes" Visibility="Collapsed" Margin="44,6,44,18">
                        <Border Style="{StaticResource PageCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Patchnotes"/>
                                    <TextBlock x:Name="NotesHeaderTitle" Text="Version –" Foreground="{StaticResource AccentCyan}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,18"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PatchnotesPanel" Margin="0,0,8,0"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- UPDATES -->
                    <Grid x:Name="PageUpdates" Visibility="Collapsed" Margin="44,6,44,18">
                        <Border Style="{StaticResource PageCard}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Updates und Installation"/>
                                    <TextBlock Style="{StaticResource PageSub}" Text="Prüft dein GitHub-Release, lädt neue Versionen herunter und installiert sie."/>

                                    <UniformGrid Columns="3" Margin="0,0,0,18">
                                        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,12">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="INSTALLIERT"/>
                                                <TextBlock x:Name="InstalledVerText" Style="{StaticResource StatValue}" Text="–"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Margin="5,0,5,0" Padding="16,12">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="VERFÜGBAR"/>
                                                <TextBlock x:Name="RemoteVerText" Style="{StaticResource StatValue}" Text="–"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Margin="10,0,0,0" Padding="16,12">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="GRÖSSE"/>
                                                <TextBlock x:Name="InstallSizeText" Style="{StaticResource StatValue}" Text="–"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <WrapPanel Margin="0,0,0,10">
                                        <Button x:Name="CheckUpdateBtn" Style="{StaticResource SecondaryButton}" Content="⟳ Nach Updates suchen" Margin="0,0,10,8" Click="CheckUpdateBtn_Click"/>
                                        <Button x:Name="InstallUpdateBtn" Style="{StaticResource UpdateActionButton}" Content="⬇ Update installieren" FontSize="13.5" Padding="16,10" Margin="0,0,10,8" Click="InstallUpdateBtn_Click"/>
                                        <Button x:Name="InstallLocalZipBtn" Style="{StaticResource SecondaryButton}" Content="📦 Lokale .zip installieren" Margin="0,0,0,8" Click="InstallLocalZipBtn_Click"/>
                                    </WrapPanel>

                                    <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="UpdateStatusText" Text="" Foreground="{StaticResource TextMuted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                    <Border x:Name="RemoteNotesCard" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="Neu in dieser Version"/>
                                            <TextBlock x:Name="RemoteNotesText" Text="" Foreground="#C4D6E8" FontSize="12.8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="INSTALLATIONSORDNER"/>
                                                <TextBlock x:Name="InstallDirLabel" Text="–" Foreground="{StaticResource TextMain}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource SecondaryButton}" Content="📂 Öffnen" Margin="0,0,8,0" Click="OpenInstallDirBtn_Click"/>
                                                <Button x:Name="UninstallBtn" Style="{StaticResource SecondaryButton}" Content="🗑 Deinstallieren" Click="UninstallBtn_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ENTWICKLER -->
                    <Grid x:Name="PageDev" Visibility="Collapsed" Margin="44,6,44,18">
                        <Border Style="{StaticResource PageCard}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Entwickler"/>
                                    <TextBlock Style="{StaticResource PageSub}" Text="Release-Build erstellen, lokal testen und an Freunde verteilen."/>

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="Release-Build"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <Button x:Name="BuildReleaseZipBtn" Style="{StaticResource PrimaryPlayButton}" Content="📦 Windows-Build + Release-ZIP erstellen" FontSize="13.5" Padding="16,10" Margin="0,0,10,8" Click="BuildReleaseZipBtn_Click"/>
                                                <Button x:Name="InstallBuiltZipBtn" Style="{StaticResource SecondaryButton}" Content="🧪 Lokal im Launcher installieren" Margin="0,0,10,8" Click="InstallBuiltZipBtn_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="📂 dist/ Ordner öffnen" Margin="0,0,0,8" Click="OpenDistDirBtn_Click"/>
                                            </WrapPanel>
                                            <ProgressBar x:Name="DevBuildProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="DevBuildStatusText" Text="Bereit." Foreground="{StaticResource TextMuted}" FontSize="12.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="Veröffentlichen"/>
                                            <WrapPanel>
                                                <Button Style="{StaticResource SecondaryButton}" Content="🌐 GitHub-Release erstellen" Margin="0,0,10,8" Click="OpenGitHubReleaseBtn_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="👥 Freunde-Paket vorbereiten" Margin="0,0,10,8" Click="PrepareFriendsBundleBtn_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="🧊 Modelle-Ordner öffnen" Margin="0,0,0,8" Click="OpenModelsBtn_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- EINSTELLUNGEN -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed" Margin="44,6,44,18">
                        <Border Style="{StaticResource PageCard}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Einstellungen"/>
                                    <TextBlock Style="{StaticResource PageSub}" Text="Download-Quelle, Installationsordner und Entwickler-Pfade."/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Update-Quelle (GitHub-Repo „owner/repo“ oder Manifest-URL)"/>
                                    <TextBox x:Name="UpdateUrlBox" Margin="0,0,0,14"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Installationsordner"/>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="InstallDirBox" Grid.Column="0"/>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Durchsuchen" Margin="8,0,0,0" Click="BrowseInstallDir_Click"/>
                                    </Grid>

                                    <Border x:Name="DevSettingsCard" Style="{StaticResource Card}" Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="Entwickler"/>

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Godot 4 (.exe)"/>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="GodotExeBox" Grid.Column="0"/>
                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Durchsuchen" Margin="8,0,0,0" Click="BrowseGodotExe_Click"/>
                                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="🔍 Automatisch" Margin="8,0,0,0" Click="AutoDetectGodot_Click"/>
                                            </Grid>

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Projektordner"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ProjectDirBox" Grid.Column="0"/>
                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Durchsuchen" Margin="8,0,0,0" Click="BrowseProjectDir_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryPlayButton}" Content="💾 Speichern" FontSize="14" Padding="20,10" Click="SaveSettingsBtn_Click"/>
                                        <TextBlock x:Name="SettingsSavedHint" Text="" Foreground="{StaticResource AccentGreen}" FontSize="12.5" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- FUSSLEISTE: STATUS + SPIELEN -->
                <Border Grid.Row="2" Background="#F20A0F18" BorderBrush="#1F2E42" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" Padding="24,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="SidebarStatusDot" Width="10" Height="10" Fill="{StaticResource AccentGreen}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                            <StackPanel MaxWidth="220">
                                <TextBlock x:Name="SidebarStatusTitle" Text="Bereit" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SidebarStatusDetail" Text="" Foreground="{StaticResource TextMuted}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="LaunchStatusTitle" Text="" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="LaunchStatusSub" Text="" Foreground="{StaticResource TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <Grid x:Name="HomeProgressRow" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="HomeProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                                <Button x:Name="CancelDownloadBtn" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="✕ Abbrechen" Padding="10,4" FontSize="11.5" Click="CancelDownloadBtn_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DevPlayBtn" Style="{StaticResource SecondaryButton}" Content="🛠 Dev-Start" Margin="0,0,8,0" Click="DevPlayBtn_Click"/>
                            <Button x:Name="DualTestBtn" Style="{StaticResource SecondaryButton}" Content="⚡ 2× Co-op Test" Margin="0,0,14,0" Click="DualTestBtn_Click"/>
                            <Button x:Name="MainActionBtn" Style="{StaticResource PrimaryPlayButton}" Content="▶  SPIELEN" Width="220" Height="56" FontSize="20" Click="MainActionBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>