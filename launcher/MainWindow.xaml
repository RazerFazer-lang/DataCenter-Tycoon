<Window x:Class="DataCenterLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataCenter Together Launcher"
        Icon="/Assets/app_icon.ico"
        Width="1240" Height="760"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentRed}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#E40E1522"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>

        <Style x:Key="PageCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="#F20B101A"/>
            <Setter Property="Padding" Value="28,22"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12.8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="17.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="14" Background="{StaticResource BgDeep}" BorderBrush="#28405D" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="0" Opacity="0.76"/>
        </Border.Effect>

        <Grid>
            <!-- Spielbild als Hintergrund -->
            <Border CornerRadius="13">
                <Border.Background>
                    <ImageBrush ImageSource="/Assets/loading_bg.png" Stretch="UniformToFill" AlignmentY="Center"/>
                </Border.Background>
            </Border>
            <Border CornerRadius="13">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EA070B12" Offset="0"/>
                        <GradientStop Color="#48070B12" Offset="0.28"/>
                        <GradientStop Color="#A8070B12" Offset="0.68"/>
                        <GradientStop Color="#F8070B12" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="13">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#BD070B12" Offset="0"/>
                        <GradientStop Color="#14070B12" Offset="0.58"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITELLEISTE MIT TABS & LAUNCHER-VERSION -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                        <Image Source="/Assets/app_icon.png" Width="36" Height="36" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DATACENTER" Foreground="{StaticResource TextMain}" FontWeight="Black" FontSize="14"/>
                            <TextBlock Text="TOGETHER" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="10.5" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button x:Name="NavPlayBtn" Style="{StaticResource TabButton}" Content="Spielen" Click="NavPlayBtn_Click"/>
                        <Button x:Name="NavNotesBtn" Style="{StaticResource TabButton}" Content="Patchnotes" Click="NavNotesBtn_Click"/>
                        <Button x:Name="NavRoadmapBtn" Style="{StaticResource TabButton}" Content="Roadmap" Click="NavRoadmapBtn_Click"/>
                        <Button x:Name="NavUpdatesBtn" Style="{StaticResource TabButton}" Content="Updates" Click="NavUpdatesBtn_Click"/>
                        <Button x:Name="NavToolsBtn" Style="{StaticResource TabButton}" Content="Werkzeuge" Click="NavToolsBtn_Click"/>
                        <Button x:Name="NavDevBtn" Style="{StaticResource TabButton}" Content="Entwickler" Click="NavDevBtn_Click"/>
                        <Button x:Name="NavSettingsBtn" Style="{StaticResource TabButton}" Content="Einstellungen" Click="NavSettingsBtn_Click"/>
                    </StackPanel>

                    <Border x:Name="TopLauncherVerPill" Grid.Column="2" Background="#162235" BorderBrush="#2A405C" BorderThickness="1"
                            CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="TopLauncherVerDot" Width="7" Height="7" Fill="{StaticResource AccentGreen}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TopBarHint" Text="Launcher v1.1.0" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Style="{StaticResource WindowButton}" Content="—" ToolTip="Minimieren" Click="MinimizeBtn_Click"/>
                        <Button Style="{StaticResource CloseWindowButton}" Content="✕" ToolTip="Schließen" Margin="4,0,0,0" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>

                <!-- LAUNCHER-UPDATE BANNER (ERSCHEINT AUTOMATISCH BEI NEUER LAUNCHER-VERSION) -->
                <Border x:Name="LauncherUpdateBanner" Grid.Row="1" Visibility="Collapsed"
                        Margin="24,0,24,10" CornerRadius="10" Padding="16,10"
                        Background="#EB291C08" BorderBrush="{StaticResource AccentAmber}" BorderThickness="1.2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="LauncherBannerTitle" Text="🚀 Neue Launcher-Version verfügbar!" Foreground="{StaticResource AccentAmber}" FontSize="13.5" FontWeight="Bold"/>
                            <TextBlock x:Name="LauncherBannerSub" Text="Aktualisiere den Launcher mit einem Klick." Foreground="#E8D8B8" FontSize="12" Margin="0,2,0,0"/>
                            <ProgressBar x:Name="LauncherUpdateProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ApplyLauncherUpdateBtn" Style="{StaticResource UpdateActionButton}" Content="⬇ Launcher aktualisieren" FontSize="12.5" Padding="14,7" Margin="0,0,8,0" Click="ApplyLauncherUpdateBtn_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Später" FontSize="12" Padding="10,7" Click="DismissLauncherBannerBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SEITEN -->
                <Grid Grid.Row="2">

                    <!-- SPIELEN -->
                    <Grid x:Name="PagePlay" Margin="40,4,32,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="400"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,34,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border x:Name="HeroStateBorder" HorizontalAlignment="Left" CornerRadius="7" Padding="11,5" Margin="0,0,10,0"
                                        Background="#3324D87A" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1">
                                    <TextBlock x:Name="HeroStateBadge" Text="BEREIT" Foreground="{StaticResource AccentGreen}" FontSize="11.5" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#B0101826" BorderBrush="#263B54" BorderThickness="1" CornerRadius="7" Padding="10,5">
                                    <TextBlock x:Name="HeroPlayTimeText" Text="⏱ Spielzeit: 0 Min." Foreground="#B6CCE2" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="DATACENTER" Foreground="{StaticResource TextMain}" FontSize="56" FontWeight="Black"/>
                            <TextBlock Text="TOGETHER" Foreground="{StaticResource AccentCyan}" FontSize="56" FontWeight="Black" Margin="0,-16,0,10"/>
                            <TextBlock Text="Baue dein eigenes Rechenzentrum, repariere Server an der Werkbank und spiele allein oder im Co-op mit Freunden."
                                       Foreground="#C4D6E8" FontSize="14.5" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left" Margin="0,0,0,18"/>
                            <WrapPanel>
                                <Button x:Name="HeroCheckUpdatesBtn" Style="{StaticResource SecondaryButton}" Content="⟳ Nach Updates suchen" Margin="0,0,10,6" Click="CheckUpdateBtn_Click"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="📁 Spielstände" Margin="0,0,10,6" Click="OpenSavesBtn_Click"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="🐛 Bug melden" ToolTip="Erstellt ein Diagnose-ZIP (inkl. godot.log) und öffnet GitHub Issues." Margin="0,0,10,6" Click="ReportBugBtn_Click"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="📄 Logs" ToolTip="Öffnet den Godot-Log-Ordner." Margin="0,0,0,6" Click="OpenLogsBtn_Click"/>
                            </WrapPanel>
                        </StackPanel>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" VerticalAlignment="Bottom">
                            <StackPanel>
                                <!-- Kompakte "Was ist neu?"-Karte mit farbigen Tags -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock x:Name="HomeWhatsNewHeader" Text="NEUESTES UPDATE" Foreground="{StaticResource AccentCyan}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button Content="Alle Patchnotes →" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                                    Foreground="{StaticResource AccentCyan}" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Click="NavNotesBtn_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="HomeWhatsNewPanel"/>
                                    </StackPanel>
                                </Border>

                                <!-- Spielsitzung -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="SPIELSITZUNG" Foreground="{StaticResource AccentCyan}" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,12"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Spielername"/>
                                                <TextBox x:Name="PlayerNameBox" MaxLength="24"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Grafikqualität"/>
                                                <ComboBox x:Name="QualityCombo">
                                                    <ComboBoxItem Content="Niedrig"/>
                                                    <ComboBoxItem Content="Mittel"/>
                                                    <ComboBoxItem Content="Hoch"/>
                                                    <ComboBoxItem Content="Ultra"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock x:Name="HomeRepoHint" Text="" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Co-op Favoriten (Schnell-Beitritt) -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="CO-OP FAVORITEN (SCHNELL-BEITRITT)" Foreground="{StaticResource AccentCyan}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Button Content="+ Server" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                                    Foreground="{StaticResource AccentGreen}" FontSize="11.5" FontWeight="Bold" Cursor="Hand" Click="AddFavServerBtn_Click"/>
                                        </Grid>
                                        <Grid x:Name="AddFavServerRow" Visibility="Collapsed" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="NewFavNameBox" Grid.Column="0" ToolTip="Servername" Text="Freunde"/>
                                            <TextBox x:Name="NewFavIpBox" Grid.Column="2" ToolTip="IP-Adresse" Text="127.0.0.1"/>
                                            <TextBox x:Name="NewFavPortBox" Grid.Column="4" ToolTip="Port" Text="7777"/>
                                            <Button Grid.Column="6" Style="{StaticResource PrimaryPlayButton}" Content="✓" FontSize="12" Padding="10,6" Click="SaveFavServerBtn_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="HomeFavServersPanel"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- PATCHNOTES MIT FARBIGEN TAGS & FILTER-CHIPS -->
                    <Grid x:Name="PageNotes" Visibility="Collapsed" Margin="40,4,40,16">
                        <Border Style="{StaticResource PageCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Patchnotes &amp; Changelog"/>
                                    <TextBlock x:Name="NotesHeaderTitle" Text="Version –" Foreground="{StaticResource AccentCyan}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                </StackPanel>
                                <WrapPanel x:Name="NotesFilterPanel" Grid.Row="1" Margin="0,0,0,12"/>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PatchnotesPanel" Margin="0,0,8,0"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ROADMAP (INTERAKTIVES 3-SPALTEN-BOARD) -->
                    <Grid x:Name="PageRoadmap" Visibility="Collapsed" Margin="40,4,40,16">
                        <Border Style="{StaticResource PageCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PageTitle}" Text="Entwicklungs-Roadmap"/>
                                        <TextBlock x:Name="RoadmapSubText" Text="Geplante Features, laufende Arbeiten und fertige Meilensteine (live von GitHub)." Foreground="{StaticResource TextMuted}" FontSize="12.8"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}" Content="⟳ Aktualisieren" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshRoadmapBtn_Click"/>
                                </Grid>
                                <UniformGrid x:Name="RoadmapColumnsGrid" Grid.Row="1" Columns="3"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- UPDATES (SPIEL + LAUNCHER GETRENNT & ÜBERSICHTLICH) -->
                    <Grid x:Name="PageUpdates" Visibility="Collapsed" Margin="40,4,40,16">
                        <Border Style="{StaticResource PageCard}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Updates &amp; Installation"/>
                                    <TextBlock Style="{StaticResource PageSub}" Text="Prüft automatisch sowohl neue Spiel-Versionen als auch neue Launcher-Updates auf GitHub Releases."/>

                                    <UniformGrid Columns="4" Margin="0,0,0,16">
                                        <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="15,11">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="SPIEL INSTALLIERT"/>
                                                <TextBlock x:Name="InstalledVerText" Style="{StaticResource StatValue}" Text="–"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Margin="4,0,4,0" Padding="15,11">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="SPIEL VERFÜGBAR"/>
                                                <TextBlock x:Name="RemoteVerText" Style="{StaticResource StatValue}" Text="–"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Margin="4,0,4,0" Padding="15,11">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="LAUNCHER VERSION"/>
                                                <TextBlock x:Name="LauncherVerStatText" Style="{StaticResource StatValue}" Text="v1.1.0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="15,11">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="SPEICHERPLATZ"/>
                                                <TextBlock x:Name="InstallSizeText" Style="{StaticResource StatValue}" Text="–"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Eigene Launcher-Update-Karte -->
                                    <Border x:Name="LauncherUpdateCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="LAUNCHER-UPDATER"/>
                                                <TextBlock x:Name="LauncherUpdateStatusText" Text="Launcher ist aktuell (v1.1.0)." Foreground="{StaticResource TextMain}" FontSize="13" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="UpdatesPageLauncherBtn" Grid.Column="1" Style="{StaticResource UpdateActionButton}"
                                                    Content="⬇ Launcher aktualisieren" FontSize="12.5" Padding="14,8" Visibility="Collapsed" Click="ApplyLauncherUpdateBtn_Click"/>
                                        </Grid>
                                    </Border>

                                    <WrapPanel Margin="0,0,0,10">
                                        <Button x:Name="CheckUpdateBtn" Style="{StaticResource SecondaryButton}" Content="⟳ Spiel &amp; Launcher prüfen" Margin="0,0,10,8" Click="CheckUpdateBtn_Click"/>
                                        <Button x:Name="InstallUpdateBtn" Style="{StaticResource UpdateActionButton}" Content="✓ Spiel ist aktuell" FontSize="13.5" Padding="16,10" Margin="0,0,10,8" Click="InstallUpdateBtn_Click"/>
                                        <Button x:Name="RepairGameBtn" Style="{StaticResource SecondaryButton}" Content="🔧 Spiel reparieren" ToolTip="Lädt das Spiel sauber neu herunter und fragt optional nach Configs / Cache." Margin="0,0,10,8" Click="RepairGameBtn_Click"/>
                                        <Button x:Name="InstallLocalZipBtn" Style="{StaticResource SecondaryButton}" Content="📦 Lokale .zip installieren" Margin="0,0,0,8" Click="InstallLocalZipBtn_Click"/>
                                    </WrapPanel>

                                    <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="UpdateStatusText" Text="" Foreground="{StaticResource TextMuted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <Border x:Name="RemoteNotesCard" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="Neu in diesem GitHub-Release"/>
                                            <StackPanel x:Name="RemoteNotesPanel"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="INSTALLATIONSORDNER"/>
                                                <TextBlock x:Name="InstallDirLabel" Text="–" Foreground="{StaticResource TextMain}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource SecondaryButton}" Content="📂 Öffnen" Margin="0,0,8,0" Click="OpenInstallDirBtn_Click"/>
                                                <Button x:Name="UninstallBtn" Style="{StaticResource SecondaryButton}" Content="🗑 Deinstallieren" Click="UninstallBtn_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- WERKZEUGE (SAVEGAME-MANAGER, MOD/SKIN-MANAGER, BUG-DIAGNOSE) -->
                    <Grid x:Name="PageTools" Visibility="Collapsed" Margin="40,4,40,16">
                        <Border Style="{StaticResource PageCard}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Werkzeuge &amp; Manager"/>
                                    <TextBlock Style="{StaticResource PageSub}" Text="Automatische Spielstand-Backups, eigene 3D-Modelle (Skins) per Drag &amp; Drop und 1-Klick-Bug-Diagnose."/>

                                    <!-- 1. Savegame-Manager -->
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource SectionTitle}" Text="💾 Spielstand-Manager &amp; Auto-Backups" Margin="0,0,0,2"/>
                                                    <TextBlock Text="Vor jedem Spiel-Update oder jeder Reparatur sichert der Launcher deine Spielstände automatisch." Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource PrimaryPlayButton}" Content="💾 Jetzt sichern" FontSize="12.5" Padding="13,7" Margin="0,0,8,0" Click="ManualBackupBtn_Click"/>
                                                    <Button Style="{StaticResource SecondaryButton}" Content="📂 Saves" Padding="11,7" Margin="0,0,8,0" Click="OpenSavesBtn_Click"/>
                                                    <Button Style="{StaticResource SecondaryButton}" Content="📂 Backups" Padding="11,7" Click="OpenBackupsBtn_Click"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="BackupStatusText" Text="" Foreground="{StaticResource AccentGreen}" FontSize="12" Margin="0,0,0,8"/>
                                            <StackPanel x:Name="BackupsListPanel"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. Custom-Modelle & Skins (Drag & Drop) -->
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource SectionTitle}" Text="🧊 Custom-Modelle &amp; Skins (.glb)" Margin="0,0,0,2"/>
                                                    <TextBlock Text="Ziehe eigene .glb-Dateien (z. B. player_realistic.glb oder delivery_driver_realistic.glb) hier hinein und aktiviere/deaktiviere sie per Klick." Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SecondaryButton}" Content="+ .glb hinzufügen" Padding="11,7" Margin="0,0,8,0" Click="AddCustomModelBtn_Click"/>
                                                    <Button Style="{StaticResource SecondaryButton}" Content="📂 Ordner" Padding="11,7" Click="OpenModelsBtn_Click"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border x:Name="ModelDropZone" AllowDrop="True" DragOver="ModelDropZone_DragOver" Drop="ModelDropZone_Drop"
                                                    Background="#101A2B" BorderBrush="#2ED8FF" BorderThickness="1.2" CornerRadius="9" Padding="16,14" Margin="0,0,0,10">
                                                <TextBlock Text="⬇ .glb-Dateien hierher ziehen (Drag &amp; Drop) — werden automatisch in deinen Custom-Models-Ordner kopiert"
                                                           Foreground="{StaticResource AccentCyan}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="ModelsStatusText" Text="" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,6"/>
                                            <StackPanel x:Name="CustomModelsListPanel"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. 1-Klick Bug melden & Diagnose -->
                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Style="{StaticResource SectionTitle}" Text="🐛 Bug melden &amp; Diagnose-Paket" Margin="0,0,0,2"/>
                                                <TextBlock x:Name="DiagStatusText" Text="Packt godot.log, Launcher-Konfiguration &amp; Systeminfos als fertige ZIP auf deinen Desktop und öffnet GitHub Issues." Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource UpdateActionButton}" Content="🐛 Diagnose erstellen &amp; Bug melden" FontSize="12.5" Padding="15,9" VerticalAlignment="Center" Click="ReportBugBtn_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ENTWICKLER -->
                    <Grid x:Name="PageDev" Visibility="Collapsed" Margin="40,4,40,16">
                        <Border Style="{StaticResource PageCard}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Entwickler"/>
                                    <TextBlock Style="{StaticResource PageSub}" Text="Spiel- &amp; Launcher-Releases bauen, lokal testen und auf GitHub veröffentlichen."/>

                                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="Release-Builds"/>
                                            <WrapPanel Margin="0,0,0,10">
                                                <Button x:Name="BuildReleaseZipBtn" Style="{StaticResource PrimaryPlayButton}" Content="📦 Spiel-Release-ZIP bauen" FontSize="13.5" Padding="16,10" Margin="0,0,10,8" Click="BuildReleaseZipBtn_Click"/>
                                                <Button x:Name="BuildLauncherReleaseBtn" Style="{StaticResource DownloadActionButton}" Content="🚀 Launcher-Release bauen (.exe + .zip)" FontSize="13.5" Padding="16,10" Margin="0,0,10,8" Click="BuildLauncherReleaseBtn_Click"/>
                                                <Button x:Name="InstallBuiltZipBtn" Style="{StaticResource SecondaryButton}" Content="🧪 Lokal im Launcher installieren" Margin="0,0,10,8" Click="InstallBuiltZipBtn_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="📂 dist/ Ordner öffnen" Margin="0,0,0,8" Click="OpenDistDirBtn_Click"/>
                                            </WrapPanel>
                                            <ProgressBar x:Name="DevBuildProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="DevBuildStatusText" Text="Bereit." Foreground="{StaticResource TextMuted}" FontSize="12.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="Veröffentlichen"/>
                                            <WrapPanel>
                                                <Button Style="{StaticResource SecondaryButton}" Content="🌐 GitHub-Release erstellen" Margin="0,0,10,8" Click="OpenGitHubReleaseBtn_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="👥 Freunde-Paket vorbereiten" Margin="0,0,10,8" Click="PrepareFriendsBundleBtn_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="🧊 Modelle-Ordner öffnen" Margin="0,0,0,8" Click="OpenModelsBtn_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- EINSTELLUNGEN -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed" Margin="40,4,40,16">
                        <Border Style="{StaticResource PageCard}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource PageTitle}" Text="Einstellungen"/>
                                    <TextBlock Style="{StaticResource PageSub}" Text="Download-Quelle, Installationsordner und Entwickler-Pfade."/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Update-Quelle (GitHub-Repo „owner/repo“ oder Manifest-URL)"/>
                                    <TextBox x:Name="UpdateUrlBox" Margin="0,0,0,14"/>

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Installationsordner"/>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="InstallDirBox" Grid.Column="0"/>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Durchsuchen" Margin="8,0,0,0" Click="BrowseInstallDir_Click"/>
                                    </Grid>

                                    <Border x:Name="DevSettingsCard" Style="{StaticResource Card}" Margin="0,0,0,18">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="Entwickler"/>

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Godot 4 (.exe)"/>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="GodotExeBox" Grid.Column="0"/>
                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Durchsuchen" Margin="8,0,0,0" Click="BrowseGodotExe_Click"/>
                                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="🔍 Automatisch" Margin="8,0,0,0" Click="AutoDetectGodot_Click"/>
                                            </Grid>

                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Projektordner"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ProjectDirBox" Grid.Column="0"/>
                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Durchsuchen" Margin="8,0,0,0" Click="BrowseProjectDir_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryPlayButton}" Content="💾 Speichern" FontSize="14" Padding="20,10" Click="SaveSettingsBtn_Click"/>
                                        <TextBlock x:Name="SettingsSavedHint" Text="" Foreground="{StaticResource AccentGreen}" FontSize="12.5" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- FUSSLEISTE: STATUS + SPIELEN -->
                <Border Grid.Row="3" Background="#F4090E17" BorderBrush="#1F2E42" BorderThickness="0,1,0,0" CornerRadius="0,0,13,13" Padding="24,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="245"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="SidebarStatusDot" Width="10" Height="10" Fill="{StaticResource AccentGreen}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                            <StackPanel MaxWidth="225">
                                <TextBlock x:Name="SidebarStatusTitle" Text="Bereit" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SidebarStatusDetail" Text="" Foreground="{StaticResource TextMuted}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="LaunchStatusTitle" Text="" Foreground="{StaticResource TextMain}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="LaunchStatusSub" Text="" Foreground="{StaticResource TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <Grid x:Name="HomeProgressRow" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="HomeProgressBar" Grid.Column="0" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                                <Button x:Name="CancelDownloadBtn" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="✕ Abbrechen" Padding="10,4" FontSize="11.5" Click="CancelDownloadBtn_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DevPlayBtn" Style="{StaticResource SecondaryButton}" Content="🛠 Dev-Start" Margin="0,0,8,0" Click="DevPlayBtn_Click"/>
                            <Button x:Name="DualTestBtn" Style="{StaticResource SecondaryButton}" Content="⚡ 2× Co-op Test" Margin="0,0,14,0" Click="DualTestBtn_Click"/>
                            <Button x:Name="MainActionBtn" Style="{StaticResource PrimaryPlayButton}" Content="▶  SPIELEN" Width="220" Height="56" FontSize="20" Click="MainActionBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
