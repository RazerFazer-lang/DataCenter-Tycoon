<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DataCenterLauncher</AssemblyName>
    <RootNamespace>DataCenterLauncher</RootNamespace>
    <Version>3.5.0</Version>
    <AssemblyVersion>3.5.0.0</AssemblyVersion>
    <FileVersion>3.5.0.0</FileVersion>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Veroeffentlichte Launcher bringen .NET immer selbst mit, egal wie "dotnet publish" aufgerufen wird. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <!-- Faengt "self-contained false" ab: Freunde ohne .NET 9 koennten den Launcher sonst nicht starten. -->
  <Target Name="RequireSelfContainedPublish" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(SelfContained)' != 'true' Or '$(PublishSingleFile)' != 'true'" Text="Launcher-Release muss self-contained und Single-File sein." />
  </Target>
  <ItemGroup>
    <Resource Include="Assets\loading_bg.png" />
    <Resource Include="Assets\app_icon.png" />
    <Resource Include="Assets\app_icon.ico" />
  </ItemGroup>
</Project>
